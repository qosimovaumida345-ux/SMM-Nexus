{
  "name": "smm-nexus-worker",
  "version": "1.0.0",
  "description": "Desktop Worker for SMM Nexus",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --targets node18-win-x64 --output dist/SMM-Nexus-Worker.exe"
  },
  "pkg": {
    "scripts": [
      "*.js"
    ],
    "assets": [
      ".env"
    ]
  },
  "dependencies": {
    "axios": "^1.6.0",
    "playwright": "^1.40.0",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
